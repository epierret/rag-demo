            "uid": "litellm-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cle AS \"Clé\", ROUND(depense_usd::numeric, 4) AS \"Dépensé (USD)\", plafond_usd AS \"Plafond (USD)\", ROUND(restant_usd::numeric, 4) AS \"Restant (USD)\", pct_utilise AS \"% utilisé\", bloquee AS \"Bloquée\" FROM monitoring.v_keys WHERE cle IN ($cle) ORDER BY depense_usd DESC"
