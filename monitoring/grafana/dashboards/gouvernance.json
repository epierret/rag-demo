    {
      "id": 5,
      "type": "table",
      "title": "Budget par clé (depuis la création)",
      "description": "Le budget est un cumul, pas un budget mensuel. La couleur passe à l'orange à 80 % et au rouge à 100 %.",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "litellm-pg"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "litellm-pg"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT cle AS \"Clé\", ROUND(depense_usd::numeric, 4) AS \"Dépensé (USD)\", plafond_usd AS \"Plafond (USD)\", ROUND(restant_usd::numeric, 4) AS \"Restant (USD)\", pct_utilise AS \"% utilisé\", bloquee AS \"Bloquée\" FROM monitoring.v_keys ORDER BY depense_usd DESC"
        }
      ],
