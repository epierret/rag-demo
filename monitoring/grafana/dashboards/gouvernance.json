    {
      "id": 8,
      "type": "table",
      "title": "Quel modèle coûte le plus cher ? (période affichée)",
      "description": "Tokens, coût et CO2 estimé par modèle, sur la période affichée.",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 24,
        "h": 6
