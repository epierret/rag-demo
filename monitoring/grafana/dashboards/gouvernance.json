          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT model AS \"Modèle\", COUNT(*) AS \"Requêtes\", SUM(tokens_total) AS \"Tokens\", ROUND(SUM(cout_usd)::numeric, 4) AS \"Coût (USD)\", ROUND(SUM(co2_g_estime), 2) AS \"CO2 estimé (g)\", BOOL_OR(facteur_manquant) AS \"Facteur manquant\" FROM monitoring.v_spend WHERE $__timeFilter(ts) AND cle IN ($cle) AND model IN ($modele) GROUP BY model ORDER BY \"Tokens\" DESC"
        }
