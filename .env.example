# Copie ce fichier en .env et remplis les valeurs. Ne committe jamais .env.

# Clé API Mistral (console Mistral). Active aussi une limite de dépense mensuelle côté Mistral.
MISTRAL_API_KEY=

# Clé maître LiteLLM : sert à créer les clés de démo. Génère-la avec : openssl rand -hex 24
LITELLM_MASTER_KEY=sk-change-me

# Mot de passe Postgres (base des clés LiteLLM). Génère-le avec : openssl rand -hex 16
POSTGRES_PASSWORD=change-me

# Monitoring (profil "monitoring" uniquement). Génère chaque mot de passe avec : openssl rand -hex 16
GRAFANA_ADMIN_PASSWORD=change-me
GRAFANA_RO_PASSWORD=change-me
# Image Grafana déjà présente sur la VM (docker images | grep grafana), pour ne pas re-télécharger
GRAFANA_IMAGE=grafana/grafana:latest
